---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign docs = site.html_pages | sort: "url" -%}
{%- for doc in docs -%}
  {%- if doc.alternate and doc.last_modified_at -%}
    {%- if doc.lang == "en" -%}
      {%- assign nl_href = doc.alternate | absolute_url -%}
      {%- assign en_href = doc.url | absolute_url -%}
    {%- else -%}
      {%- assign nl_href = doc.url | absolute_url -%}
      {%- assign en_href = doc.alternate | absolute_url -%}
    {%- endif -%}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
    <lastmod>{{ doc.last_modified_at | date_to_xmlschema }}</lastmod>
    <xhtml:link rel="alternate" hreflang="nl" href="{{ nl_href }}" />
    <xhtml:link rel="alternate" hreflang="en" href="{{ en_href }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ nl_href }}" />
  </url>
  {%- endif -%}
{%- endfor -%}
</urlset>
