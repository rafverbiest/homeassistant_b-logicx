      "import_yaml": {
        "title": "Import from YAML",
        "description": "{warning}\n\nUpload a YAML file matching the template (addresses: list). This replaces all configured entries.",
        "data": {
          "import_yaml": "YAML file"
        }
      },
      "download_yaml_template": {
        "title": "Download YAML template",
        "description": "{warning}\n\n{template}",
        "data": {
          "template": "Template content (copy everything below)"
        }
      }
